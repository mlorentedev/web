  "cards": [
    {
      "dot": "cyan",
      "title": "Encrypted at Rest",
      "items": [
        "All secrets committed to Git are encrypted with asymmetric Age keys via Mozilla SOPS",
        "Zero plaintext tokens, passwords, or private keys ever reach the repository history"
      ]
    },
    {
      "dot": "slate",
      "title": "In-Memory Cryptography",
      "items": [
        "toolkit secrets decrypts manifests directly in volatile memory without intermediate files",
        "One-way key derivation generates Argon2id hashes for Authelia and bcrypt for Argo CD"
      ]
    },
    {
      "dot": "emerald",
      "title": "Zero-Leakage Runtime",
      "items": [
        "Kubernetes Secret objects are scoped strictly to their consuming namespaces and RBAC roles",
        "Pod mounts consume memory-backed tmpfs projections to prevent secret spills into container logs"
      ]
    }
  ]
