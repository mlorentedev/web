  "cards": [
    {
      "dot": "cyan",
      "title": "Centralized Hub Control",
      "items": [
        "Argo CD runs on an isolated GCP instance, decoupled from application workloads",
        "Declarative Kustomize manifests define desired state without manual cluster changes"
      ]
    },
    {
      "dot": "slate",
      "title": "Zero-Trust Mesh Transport",
      "items": [
        "All cluster API endpoints remain private and unreachable from the public internet",
        "WireGuard overlay provides encrypted point-to-point synchronization across cloud and homelab"
      ]
    },
    {
      "dot": "emerald",
      "title": "Immutable Delivery",
      "items": [
        "GitHub Actions builds multi-arch OCI images stamped with deterministic Git digests",
        "Spoke clusters pull verified digests with zero drift across staging and production"
      ]
    }
