---
import Button from './Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import type { languages } from '../i18n/ui';

interface Props {
  lang: keyof typeof languages;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={t('404.title')} description={t('404.text')} noindex={true} hasAlternates={false}>
  <Header hasAlternates={false} />
  <main id="main-content" class="grow pb-16">
    <section class="pt-20 pb-16 md:pt-24 md:pb-20">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <h1 class="text-6xl font-extrabold text-ink-500 mb-6">404</h1>
        <p class="text-ink-500 text-lg mb-10">{t('404.text')}</p>
        <Button href={translatePath('/')}>{t('404.cta')}</Button>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
