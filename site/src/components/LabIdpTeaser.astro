---
/**
 * The Lab's IDP (Internal Developer Platform) Catalog Teaser section (WEB-080, WEB-096).
 *
 * Surfaces high-level platform spend and operational domains, linking directly
 * to the complete `/lab/idp` catalog without bloating `/lab`'s AC6 weight budget.
 */
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getLocale, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  /** Section number in the page's sequence, e.g. "08". */
  number: string;
}

const { number } = Astro.props;

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Section padding="py-10" data-lab-section="idp">
  <SectionHeading number={number} label={t('lab.idp.heading')} margin="mb-3" />

  <p class="text-sm text-ink-600 leading-relaxed max-w-3xl mb-6">
    {t('lab.idp.intro')}
  </p>

  <div class="rounded-lg bg-panel-50 border border-panel-200 p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
    <div class="space-y-3">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <div>
          <span class="block text-xs font-mono uppercase tracking-wider text-ink-500 mb-0.5">
            {t('lab.idp.spendLabel')}
          </span>
          <span class="text-base font-bold font-mono text-ink-900">
            {t('lab.idp.spendValue')}
          </span>
          <span class="text-xs text-ink-500 ml-1.5 font-mono">
            ({t('lab.idp.spendDate')})
          </span>
        </div>

        <div class="hidden sm:block w-px h-8 bg-panel-200"></div>

        <div>
          <span class="block text-xs font-mono uppercase tracking-wider text-ink-500 mb-0.5">
            {t('lab.idp.categoriesLabel')}
          </span>
          <span class="text-xs font-mono text-panel-700">
            {t('lab.idp.categoriesValue')}
          </span>
        </div>
      </div>
    </div>

    <div class="shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-panel-200">
      <a
        href={translatePath('/lab/idp')}
        class="inline-flex items-center gap-2 text-sm font-semibold text-accent-700 hover:text-accent-900 transition-colors focus:outline-none focus:underline"
      >
        <span>{t('lab.idp.cta')}</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</Section>
