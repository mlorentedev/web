---
// The one way in (WEB-137): a mail whose body is the written filter, three
// lines, plus the busy line while a project is running. Placed from the contact
// markdown, so the order of the page stays Manu's to edit.
import { site } from '../data/site';
import { busyMonth } from '../data/availability.mjs';
import { getLocale, getDateLocale, useTranslations } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

// RFC 6068 wants CRLF line breaks in a mailto body.
const body = t('door.body').replace(/\n/g, '\r\n');
const mailto = `mailto:${site.social.email}?subject=${encodeURIComponent(t('door.subject'))}&body=${encodeURIComponent(body)}`;

// Judged at build time; the inline script below hides the line in the browser
// once the date passes, so a page built before it cannot keep saying it after.
const month = busyMonth(site.nextStart, new Date(), getDateLocale(lang));
---

<div data-door class="not-prose my-8">
  {month && (
    <p data-busy data-until={site.nextStart} class="mb-4 text-sm font-mono text-ink-500">
      {t('door.busy').replace('{month}', month)}
    </p>
  )}
  <a
    href={mailto}
    class="inline-block px-6 py-2.5 bg-ink-900 text-white rounded-md text-sm font-medium hover:bg-accent-700 transition-colors focus:outline-hidden focus:ring-2 focus:ring-accent-300 shadow-xs"
  >
    {t('door.cta')}
  </a>
  <p class="mt-3 text-sm text-ink-500">{site.social.email}</p>
  {month && (
    <script is:inline>
      document.querySelectorAll('[data-busy]').forEach((el) => {
        if (Date.now() >= Date.parse(el.dataset.until + 'T00:00:00Z')) el.hidden = true;
      });
    </script>
  )}
</div>
