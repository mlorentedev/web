---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import { notesIn, type Note } from '../lib/locale-pages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const latest = async (l: Lang) => (await notesIn(l)).slice(0, 3);

// A locale with no notes of its own shows the English ones, marked as English,
// rather than an empty "coming soon" band on the home (#499).
const own = await latest(lang);
const fallback = own.length === 0 && lang !== 'en';
const notes: Note[] = fallback ? await latest('en') : own;
const noteHref = (id: string) => (fallback ? `/notes/${id}/` : translatePath(`/notes/${id}/`));
const allHref = fallback ? '/notes/' : translatePath('/notes/');
---

<Section data-home-block="notes">
  <SectionHeading label={t('home.latest')} href={allHref} margin="mb-6" />
    {fallback && notes.length > 0 && <p data-notes-in-english class="text-sm text-ink-500 mb-3">{t('notes.inEnglish')}</p>}
    {notes.length > 0 ? (
      <div class="divide-y divide-ink-100" lang={fallback ? 'en' : undefined}>
        {notes.map((note) => (
          <a href={noteHref(note.id)} class="group block py-3 first:pt-0">
            <span class="text-sm text-ink-500 block tabular-nums">{note.data.pubDate.toISOString().slice(0, 10)}</span>
            <span class="text-base text-ink-700 group-hover:text-accent-700 transition-colors">{note.data.title}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-base text-ink-500">{t('notes.empty')}</p>
    )}
    <a
      href={allHref}
      class="text-xs text-ink-500 hover:text-accent-700 transition-colors mt-4 block"
    >
      {t('home.allNotes')} &rarr;
    </a>
</Section>
