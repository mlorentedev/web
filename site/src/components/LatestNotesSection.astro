---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const notes: CollectionEntry<'notes'>[] = (
  await getCollection('notes', ({ data }: CollectionEntry<'notes'>) => !data.draft && data.lang === lang)
)
  .sort((a: CollectionEntry<'notes'>, b: CollectionEntry<'notes'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Section>
  <SectionHeading label={t('home.latest')} href={translatePath('/notes')} margin="mb-6" />
    {notes.length > 0 ? (
      <div class="divide-y divide-gray-100">
        {notes.map((note) => (
          <a href={translatePath(`/notes/${note.id}`)} class="group block py-3 first:pt-0">
            <span class="text-sm text-gray-500 block tabular-nums">{note.data.pubDate.toISOString().slice(0, 10)}</span>
            <span class="text-base text-gray-700 group-hover:text-cyan-700 transition-colors">{note.data.title}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-base text-gray-500">{t('notes.empty')}</p>
    )}
    <a
      href={translatePath('/notes')}
      class="text-xs text-gray-500 hover:text-cyan-700 transition-colors mt-4 block"
    >
      {t('home.allNotes')} &rarr;
    </a>
</Section>
