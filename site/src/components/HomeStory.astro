---
// The home's story (#499): career and studies on one vertical line, newest
// first, then a short note in `content/pages/<lang>-bio.mdx`. Roles come from
// `data/experience.ts` and studies from `data/education.ts`. A filled dot marks
// work, a hollow one study, and the ongoing role carries a halo. Years sit left
// of the line on wide screens and above each entry on a phone.
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { education } from '../data/education';
import { experience } from '../data/experience';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const [bio] = await getCollection('pages', ({ data }: CollectionEntry<'pages'>) => data.page === 'bio' && data.lang === lang);
if (!bio) throw new Error(`HomeStory: no bio for "${lang}" — expected src/content/pages/${lang}-bio.mdx with page: bio`);
const { Content: Bio } = await render(bio);

type Entry = { kind: 'work' | 'study'; start: string; end: number; until: string; title: string; place: string; detail: string; current: boolean };

const thisYear = new Date().getFullYear();
const work: Entry[] = experience.map((e) => ({
  kind: 'work',
  start: e.start,
  end: e.end === null ? thisYear : Number(e.end),
  until: e.end ?? t('home.timeline.present'),
  title: e[lang].role,
  place: `${e.company} · ${e.location[lang]}`,
  detail: e[lang].highlight,
  current: e.end === null,
}));
const study: Entry[] = education.map((e) => ({
  kind: 'study',
  start: e.start,
  end: Number(e.end),
  until: e.end,
  title: e[lang],
  place: e.school,
  detail: '',
  current: false,
}));
const entries = [...work, ...study].sort((a, b) => Number(b.start) - Number(a.start) || b.end - a.end);
---

<Section id="story" data-home-block="story">
  <SectionHeading label={t('home.experience')} margin="mb-4" />
  <p class="mb-8 flex gap-5 font-mono text-xs text-ink-500" aria-hidden="true">
    <span class="inline-flex items-center gap-2"><span class="size-2.5 rounded-full bg-accent-600"></span>{t('home.timeline.work')}</span>
    <span class="inline-flex items-center gap-2"><span class="size-2.5 rounded-full border-2 border-accent-500 bg-white"></span>{t('home.timeline.study')}</span>
  </p>
  <ol data-timeline class="max-w-3xl md:ml-36">
    {entries.map((item) => (
      <li data-timeline-item data-kind={item.kind} class="group relative pl-8 pb-8 last:pb-0">
        <span class="absolute left-[5px] top-2 -bottom-2 w-px bg-ink-200 group-last:hidden" aria-hidden="true"></span>
        <span
          class:list={[
            'absolute left-0 top-1.5 size-3 rounded-full',
            item.kind === 'work' ? 'bg-accent-600' : 'border-2 border-accent-500 bg-white',
            item.current && 'ring-4 ring-accent-100',
          ]}
          aria-hidden="true"
        ></span>
        <p class="font-mono text-xs text-ink-500 tabular-nums md:absolute md:right-full md:top-1 md:mr-6 md:w-28 md:text-right">{item.start}–{item.until}</p>
        <p class:list={['text-ink-900', item.kind === 'work' ? 'font-semibold' : 'font-medium text-sm']}><span class="sr-only">{t(item.kind === 'work' ? 'home.timeline.work' : 'home.timeline.study')}: </span>{item.title}</p>
        <p class="text-sm text-ink-500">{item.place}</p>
        {item.detail && <p class="mt-1.5 text-sm text-ink-700 leading-relaxed">{item.detail}</p>}
      </li>
    ))}
  </ol>
  <div data-bio class="prose prose-base max-w-3xl mt-10 prose-p:text-ink-700 prose-p:leading-relaxed prose-a:text-accent-700 hover:prose-a:text-accent-800">
    <Bio />
  </div>
</Section>
