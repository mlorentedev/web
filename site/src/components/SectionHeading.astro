---
/**
 * The numbered `[ NN / label ]` section heading used across the site.
 *
 * It was hand-duplicated in seven components and six more times on the cockpit
 * page, with the class string retyped each time — which is how one of them ended
 * up as an `<a>` instead of an `<h2>` and put a hole in the heading outline.
 *
 * `margin` is the caller's, because the spacing below the heading belongs to the
 * section's own rhythm rather than to the heading: most want `mb-8` or `mb-6`,
 * and the ones that sit in a flex row beside a badge want none.
 */
interface Props {
  /** Zero-padded section number, e.g. "03". Omit for an unnumbered heading. */
  number?: string;
  label: string;
  /** Links the label only, leaving the heading a heading. */
  href?: string;
  /** Spacing below the heading, e.g. "mb-8". */
  margin?: string;
}

const { number, label, href, margin } = Astro.props;
const bracket = number ? `[ ${number} /` : '[';
---

<h2 class:list={['text-sm font-medium text-gray-500 tracking-widest uppercase', margin]}><span class="text-cyan-700">{bracket}</span> {href ? <a href={href} class="hover:text-cyan-700 transition-colors">{label}</a> : label} <span class="text-cyan-700">]</span></h2>
