---
import type { LocalizedProject } from '../data/portfolio';
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  /** A project already flattened to the current language (see `localize`). */
  project: LocalizedProject;
  /** Current UI language — drives tag links and the "View project" label. */
  lang: Lang;
  /** Heading level of the project name: 2 where no section heading sits above the cards. */
  level?: 2 | 3;
}

const { project, lang, level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Preferred link: the live/demo URL, falling back to the source repo. A site path
// (`/lab`) stays in the reader's locale. No link opens a new tab (WEB-167).
const target = project.url ?? project.github;
const internal = target?.startsWith('/') ?? false;
const link = target && internal ? translatePath(target) : target;

// The state and the start year (#587), one plain line under the name.
const status = { active: t('projects.status.active') }[project.status];
const since = t('projects.since').replace('{year}', String(project.since));
---

<div class="border border-ink-200 bg-white rounded-lg p-5 hover:border-accent-700 transition-colors flex flex-col shadow-xs">
  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
    <Heading data-project-title class="font-bold text-ink-900 text-lg leading-snug text-balance">
      {link ? (
        <a href={link} class="hover:text-accent-700 transition-colors">
          {project.title}
        </a>
      ) : (
        project.title
      )}
    </Heading>
    <span
      data-metric
      class="px-2 py-0.5 rounded bg-accent-50 text-accent-700 text-xs font-semibold tabular-nums font-mono whitespace-nowrap shrink-0"
    >
      {project.metric}
    </span>
  </div>

  <div data-project-meta class="mb-3 text-xs font-mono text-ink-500">
    <span data-status={project.status}>{status}</span> · <span>{since}</span>
  </div>

  <p class="text-ink-600 text-sm sm:text-base leading-relaxed mb-4 grow text-pretty sm:leading-6">{project.description}</p>

  {project.install && (
    // No copy button: the site ships no client JavaScript (WEB-179). One click
    // selects the whole command instead, and the prompt stays out of the selection.
    <div data-install class="mb-4 rounded bg-ink-900 px-3 py-2 font-mono text-sm wrap-break-word">
      <span aria-hidden="true" class="select-none text-ink-400">$ </span><code translate="no" class="select-all text-ink-100">{project.install}</code>
    </div>
  )}

  <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-ink-100">
    {project.tags.map((tag) => (
      <a
        href={translatePath(`/tags/${tag.toLowerCase()}`)} data-tag-chip
        class="inline-flex min-h-7 min-w-6 items-center justify-center px-2 text-xs rounded bg-ink-100 text-ink-600 hover:bg-accent-700 hover:text-white transition-colors"
      >
        {tag}
      </a>
    ))}
    {link && (
      <a
        href={link}
        class="ml-auto text-xs font-mono font-medium text-accent-700 hover:text-accent-900 hover:underline whitespace-nowrap"
      >
        {t('projects.viewProject')} &rarr;
      </a>
    )}
  </div>
</div>
