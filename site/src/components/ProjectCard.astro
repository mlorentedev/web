---
import type { LocalizedProject } from '../data/portfolio';
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  /** A project already flattened to the current language (see `localize`). */
  project: LocalizedProject;
  /** Current UI language — drives tag links and the "View project" label. */
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Preferred link: the live/demo URL, falling back to the source repo.
const link = project.url ?? project.github;
---

<div class="border border-ink-200 bg-white rounded-lg p-5 hover:border-accent-700 transition-colors flex flex-col shadow-sm">
  <div class="flex items-baseline justify-between gap-2 mb-2">
    <h3 class="font-bold text-ink-900 text-lg leading-snug [text-wrap:balance]">
      {link ? (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-700 transition-colors"
        >
          {project.title}
        </a>
      ) : (
        project.title
      )}
    </h3>
    <span
      data-metric
      class="px-2 py-0.5 rounded bg-accent-50 text-accent-700 text-xs font-semibold tabular-nums font-mono whitespace-nowrap"
    >
      {project.metric}
    </span>
  </div>

  <p class="text-ink-600 text-sm sm:text-base leading-relaxed mb-4 flex-grow [text-wrap:pretty]">{project.description}</p>

  <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-ink-100">
    {project.tags.map((tag) => (
      <a
        href={translatePath(`/tags/${tag.toLowerCase()}`)}
        class="px-2 py-0.5 text-xs rounded bg-ink-100 text-ink-600 hover:bg-accent-700 hover:text-white transition-colors"
      >
        {tag}
      </a>
    ))}
    {link && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto text-xs font-mono font-medium text-accent-700 hover:text-accent-900 hover:underline whitespace-nowrap"
      >
        {t('projects.viewProject')} &rarr;
      </a>
    )}
  </div>
</div>
