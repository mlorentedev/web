---
import { getLocale, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const labHref = translatePath('/lab');
const ctaHref = translatePath('/contact');
---

<div class="max-w-4xl mx-auto px-4 pt-6 pb-12 text-gray-800">
  <div class="flex items-center gap-3 mb-5">
    <p class="text-sm font-medium text-gray-500 tracking-widest uppercase">
      <span class="text-cyan-700">[</span> {t('hero.eyebrow')} <span class="text-cyan-700">]</span>
    </p>
    <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono bg-emerald-50 text-emerald-700 border border-emerald-200/80">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      KubeLab 24/7 · GitOps
    </span>
  </div>
  <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">{t('hero.title')}</h1>
  <p class="text-xl text-gray-500 mt-5 leading-relaxed">{t('hero.subtitle')}</p>
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href={labHref}
      class="inline-flex items-center gap-2 rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-cyan-700 transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 shadow-sm"
    >
      <span>{t('idp.cta')}</span>
    </a>
    <a
      href="#projects"
      class="inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:border-gray-400 hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500"
    >
      <span>{t('home.projects')}</span>
    </a>
    <a
      href={ctaHref}
      class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm text-gray-500 hover:text-cyan-700 transition-colors"
    >
      <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
      {t('hero.cta')}
    </a>
  </div>
</div>
