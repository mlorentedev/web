---
// The hero: who this is, and the one way in, on the first screen (#499). The
// contact button sits here, not at the foot of the home, so nobody has to scroll
// to find it. The home states no offer: the site sells a hire (#518).
import Button from './Button.astro';
import { getLocale, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="max-w-6xl mx-auto px-4 pt-8 pb-10 text-ink-900">
  <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-900 tracking-tight leading-[1.18] text-balance wrap-break-word sm:leading-10 lg:leading-none">{t('hero.title')}</h1>
  <p data-hero-subtitle class="text-base sm:text-lg lg:text-xl text-ink-600 mt-5 leading-relaxed max-w-3xl text-pretty sm:leading-7">{t('hero.subtitle')}</p>
  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
    <Button data-home-door href={translatePath('/contact/')} class="w-fit">{t('home.cta.button')}</Button>
    <p class="max-w-xl text-sm text-ink-500 leading-relaxed">{t('home.cta.body')}</p>
  </div>
</div>
