---
/**
 * The 104-Week AI Platform & SRE Curriculum.
 *
 * Visualizes the 4 distinct technical epochs spanning 1.5 years back and 6 months forward.
 */
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getLocale, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  number: string;
}

const { number } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const epochs = [
  {
    range: 'W -78 → -53',
    period: lang === 'es' ? 'Marzo 2025 – Septiembre 2025' : 'March 2025 – September 2025',
    title: lang === 'es' ? 'Época I: Hardware, Redes y Fundamentos del Homelab' : 'Epoch I: Hardware, Mesh Networks & Homelab Foundations',
    summary: lang === 'es'
      ? 'Del hardware bare-metal a la alta disponibilidad: Mini PCs, pools ZFS en Proxmox, WireGuard, Headscale, túneles DERP y resolución de split-horizon DNS.'
      : 'From bare-metal to high availability: Mini PCs, Proxmox ZFS pools, WireGuard, Headscale DERP relays, and split-horizon DNS resolution.',
    topics: lang === 'es'
      ? ['Mini PCs y TDP', 'Headscale y WireGuard', 'El infierno de CoreDNS y Pi-hole', 'Storage local S3 MinIO']
      : ['Mini PC sizing & TDP', 'Headscale & WireGuard', 'CoreDNS & Pi-hole debugging', 'Local S3 MinIO storage'],
    status: lang === 'es' ? 'Completado' : 'Completed',
    statusClass: 'bg-panel-100 text-panel-700 border-panel-200'
  },
  {
    range: 'W -52 → -27',
    period: lang === 'es' ? 'Septiembre 2025 – Marzo 2026' : 'September 2025 – March 2026',
    title: lang === 'es' ? 'Época II: Kubernetes K3s, GitOps Declarativo y Edge' : 'Epoch II: Lightweight K3s, Declarative GitOps & Edge Delivery',
    summary: lang === 'es'
      ? 'De contenedores sueltos a entrega continua: K3s multi-nodo, Argo CD monorepo, Traefik v3, Authelia SSO, Docker multi-arch nativo y backups Velero a Cloudflare R2.'
      : 'From loose containers to declarative delivery: Multi-node K3s, Argo CD monorepo, Traefik v3, Authelia SSO, native multi-arch builds, and Velero R2 backups.',
    topics: lang === 'es'
      ? ['Bootstrap K3s con Ansible', 'Argo CD sin bloat de Helm', 'Traefik v3 y Authelia 2FA', 'Backups sin egress con Velero y R2']
      : ['K3s Ansible bootstrap', 'Argo CD monorepo', 'Traefik v3 & Authelia SSO', 'Zero-egress Velero & R2 backups'],
    status: lang === 'es' ? 'Completado' : 'Completed',
    statusClass: 'bg-panel-100 text-panel-700 border-panel-200'
  },
  {
    range: 'W -26 → 00',
    period: lang === 'es' ? 'Marzo 2026 – Septiembre 2026' : 'March 2026 – September 2026',
    title: lang === 'es' ? 'Época III: El Nacimiento del Arnés de IA y FastMCP' : 'Epoch III: The AI Harness, FastMCP & Concurrency Sandboxes',
    summary: lang === 'es'
      ? 'Tratar LLMs como motores estocásticos dentro de un arnés determinista: FastMCP con PyMuPDF, SQLite FTS5 BM25, git worktrees efímeros y semáforos flock en Go.'
      : 'Treating LLMs as stochastic engines inside a deterministic harness: FastMCP with PyMuPDF, SQLite FTS5 BM25, ephemeral git worktrees, and Go flock semaphores.',
    topics: lang === 'es'
      ? ['Doctrina de Cero Atribución a IA', 'Servidor FastMCP en producción', 'Sandboxing con git worktrees', 'Semáforos flock a nivel de kernel']
      : ['Zero AI attribution doctrine', 'Production FastMCP server', 'Ephemeral worktree sandboxing', 'Kernel-level flock semaphores'],
    status: lang === 'es' ? 'Activo' : 'Active',
    statusClass: 'bg-ok-50 text-ok-700 border-ok-200'
  },
  {
    range: 'W +01 → +26',
    period: lang === 'es' ? 'Septiembre 2026 – Marzo 2027' : 'September 2026 – March 2027',
    title: lang === 'es' ? 'Época IV: La Frontera AI Platform y Telemetría OTel' : 'Epoch IV: AI Platform Frontier, CI Evals & GenAI Telemetry',
    summary: lang === 'es'
      ? 'La frontera inmediata de ingeniería: Chunker jerárquico AST en Hive, recuperación contextual, suites de evaluación en GitHub Actions y telemetría OpenTelemetry GenAI.'
      : 'The immediate engineering frontier: Hive AST hierarchical chunker, contextual retrieval, CI eval regression suites, and OpenTelemetry GenAI telemetry.',
    topics: lang === 'es'
      ? ['Chunker jerárquico AST en Hive', 'Búsqueda híbrida con RRF', 'Evals como tests en GitHub Actions', 'OpenTelemetry GenAI y Cockpit']
      : ['Hive AST syntax chunker', 'Hybrid search with RRF', 'CI eval suites in GitHub Actions', 'OpenTelemetry GenAI & Cockpit'],
    status: lang === 'es' ? 'En Desarrollo' : 'In Progress',
    statusClass: 'bg-accent-50 text-accent-700 border-accent-200'
  }
];
---

<Section padding="py-14" data-ai-section="roadmap">
  <SectionHeading number={number} label={t('ai.roadmap.heading')} margin="mb-2" />
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 mb-8">
    <p class="text-sm text-ink-500 max-w-2xl">
      {t('ai.roadmap.sub')}
    </p>
    <a
      href={translatePath('/notes')}
      class="text-xs font-medium text-accent-700 hover:text-accent-800 transition-colors inline-flex items-center gap-1 shrink-0"
    >
      <span>{lang === 'es' ? 'Explorar todas las notas publicadas' : 'Browse all published notes'}</span>
      <span>→</span>
    </a>
  </div>

  <div class="space-y-6">
    {epochs.map((epoch) => (
      <div class="p-5 rounded-lg border border-ink-200 bg-white hover:border-ink-300 transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs font-bold px-2 py-0.5 rounded-sm bg-ink-100 text-ink-800">
              {epoch.range}
            </span>
            <span class="text-xs text-ink-400 font-mono">
              ({epoch.period})
            </span>
          </div>
          <span class:list={['text-xs font-mono px-2 py-0.5 rounded-full border self-start sm:self-auto', epoch.statusClass]}>
            {epoch.status}
          </span>
        </div>

        <h3 class="text-base font-semibold text-ink-900 mb-2">
          {epoch.title}
        </h3>
        <p class="text-sm text-ink-600 leading-relaxed mb-4">
          {epoch.summary}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 pt-3 border-t border-ink-100">
          {epoch.topics.map((topic) => (
            <div class="text-xs text-ink-600 flex items-center gap-1.5">
              <span class="text-accent-700 font-mono font-bold">›</span>
              <span>{topic}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>
