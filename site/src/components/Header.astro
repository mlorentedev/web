---
import { languages } from '../i18n/ui';
import { getLocale, useTranslations, useTranslatedPath, switchLangUrl } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navItems: { label: string; href: string }[] = [
  { label: t('nav.ai'), href: translatePath('/ai') },
  { label: t('nav.lab'), href: translatePath('/lab') },
  { label: t('nav.notes'), href: translatePath('/notes') },
  { label: t('nav.contact'), href: translatePath('/contact') },
];

const currentPath = Astro.url.pathname;
const otherLangs = Object.entries(languages).filter(([l]) => l !== lang);
---

<header class="bg-accent-50 text-ink-700 sticky top-0 w-full border-b border-accent-100 z-50">
  <nav class="px-3 sm:px-4 py-3 flex items-center justify-between">
    <span class="text-xl font-extrabold">
      <a href={translatePath('/')} class="no-underline hover:text-accent-700 transition-colors duration-200 focus:outline-none focus:text-accent-700">
        Manu Lorente
      </a>
    </span>

    <div class="fixed left-1/2 transform -translate-x-1/2 top-1 z-[60]">
      <a href={translatePath('/')}>
        <img
          src="/images/me-2.webp"
          alt="Manu Lorente"
          width="96"
          height="125"
          class="w-12 h-auto rounded-full border-[1.5px] border-white shadow-lg"
        />
      </a>
    </div>

    <!-- Tighter gaps below sm: the fourth nav item pushes the row past a 320px
         viewport at the desktop spacing. A real mobile menu is WEB-042. -->
    <div class="flex items-center space-x-2 sm:space-x-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'hover:text-accent-700 focus:outline-none focus:text-accent-700 transition-colors duration-200 text-sm',
            currentPath === item.href || currentPath.startsWith(item.href + '/')
              ? 'text-accent-700 font-bold no-underline'
              : '',
          ]}
        >
          {item.label}
        </a>
      ))}
      {otherLangs.map(([l, label]) => (
        <a
          href={switchLangUrl(Astro.url, l as keyof typeof languages)}
          aria-label={label}
          class="text-xs text-ink-500 hover:text-accent-700 focus:outline-none focus:text-accent-700 transition-colors uppercase tracking-wide"
        >
          {/* The code below sm — the full name does not fit a 320px viewport
              once the nav carries four items. */}
          <span class="sm:hidden" aria-hidden="true">{l}</span>
          <span class="hidden sm:inline">{label}</span>
        </a>
      ))}
    </div>
  </nav>
</header>
