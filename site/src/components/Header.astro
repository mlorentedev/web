---
import { languages } from '../i18n/ui';
import { getLocale, useTranslations, useTranslatedPath, switchLangUrl } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// `name`: the label is a name in every locale, so it is marked `translate="no"`.
const navItems: { label: string; href: string; name?: boolean }[] = [
  { label: t('nav.lab'), href: translatePath('/lab/'), name: true },
  { label: t('nav.ai'), href: translatePath('/ai/') },
  { label: t('nav.notes'), href: translatePath('/notes/') },
  { label: t('nav.contact'), href: translatePath('/contact/') },
];

interface Props {
  hasAlternates?: boolean;
}

const { hasAlternates = true } = Astro.props;
const currentPath = Astro.url.pathname;
const otherLangs = Object.entries(languages).filter(([l]) => l !== lang);
---

<header class="bg-accent-50 text-ink-700 sticky top-0 w-full border-b border-accent-100 z-50">
  <nav aria-label={t('nav.label')} class="max-w-6xl mx-auto px-4 py-2 flex items-center justify-between">
    <!-- One link for the portrait and the name. Below sm the name does not fit
         beside the nav, so it stays as the link's accessible name only. -->
    <a
      data-header-brand
      href={translatePath('/')}
      aria-current={currentPath === translatePath('/') ? 'page' : undefined}
      class="flex shrink-0 items-center gap-2 text-xl font-extrabold no-underline hover:text-accent-700 transition-colors duration-200"
    >
      <img
        src="/images/me-2.webp"
        alt=""
        width="96"
        height="125"
        class="h-9 w-auto rounded-full border-[1.5px] border-white shadow-sm"
      />
      <span translate="no" class="sr-only sm:not-sr-only">Manu Lorente</span>
    </a>

    <!-- Tighter gaps below sm: the fourth nav item pushes the row past a 320px
         viewport at the desktop spacing. A real mobile menu is WEB-042. -->
    <div data-header-links class="flex items-center space-x-2 sm:space-x-4">
      {navItems.map((item) => {
        const here = currentPath === item.href;
        const within = currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            translate={item.name ? 'no' : undefined}
            aria-current={here ? 'page' : within ? 'true' : undefined}
            class:list={[
              'inline-flex min-h-6 min-w-6 items-center justify-center hover:text-accent-700 transition-colors duration-200 text-sm',
              within ? 'text-accent-700 font-bold no-underline' : '',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      {hasAlternates && otherLangs.map(([l, label]) => (
        <a
          href={switchLangUrl(Astro.url, l as keyof typeof languages)}
          aria-label={`${label} ${l.toUpperCase()}`}
          class="inline-flex min-h-6 min-w-6 items-center justify-center text-xs text-ink-500 hover:text-accent-700 transition-colors uppercase tracking-wide"
        >
          {/* The code below sm — the full name does not fit a 320px viewport
              once the nav carries four items. The accessible name carries both
              the name and the code, so whichever one is on screen is part of it
              (WCAG 2.5.3, axe label-content-name-mismatch). No brackets around
              the code: axe 4.14 matches whole words, and "(ES)" is not "es". */}
          <span class="sm:hidden" aria-hidden="true">{l}</span>
          <span class="hidden sm:inline">{label}</span>
        </a>
      ))}
    </div>
  </nav>
</header>
