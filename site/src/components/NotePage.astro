---
// One note, for one locale. Its paths come from `notePaths` in lib/locale-pages.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import NoteClosing from './NoteClosing.astro';
import NoteSupersededNotice from './NoteSupersededNotice.astro';
import Footer from './Footer.astro';
import { render } from 'astro:content';
import { useTranslations, useTranslatedPath, formatDate, isoDate } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../data/site';
import { blogPosting, breadcrumbs } from '../data/structured-data';
import type { Note, NoteLink } from '../lib/locale-pages';
import { modifiedDate, shownWrittenDate } from '../lib/note-dates.mjs';
import { cardPath } from '../lib/og-cards.mjs';

interface Props {
  lang: Lang;
  note: Note;
  prev: NoteLink;
  next: NoteLink;
}

const { lang, note, prev, next } = Astro.props;
const { Content } = await render(note);

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// A note written before it shipped shows when it was written, then when it was published.
const { pubDate } = note.data;
const writtenDate = shownWrittenDate(note.data);
const shownDate = writtenDate ?? pubDate;
const path = translatePath(`/notes/${note.id}`);
// The note's own social card (WEB-176): og:image, twitter:image and the BlogPosting's image.
const ogImage = cardPath(note.id);
// One modified date for the meta, the graph and, read from the meta, the sitemap (WEB-050).
const article = { publishedTime: isoDate(pubDate), modifiedTime: isoDate(modifiedDate(note.data)) };
const schema = [
  blogPosting({
    path,
    title: note.data.title,
    description: note.data.description,
    datePublished: article.publishedTime,
    dateModified: article.modifiedTime,
    dateCreated: writtenDate && isoDate(writtenDate),
    tags: note.data.tags,
    lang,
    image: ogImage,
  }),
  breadcrumbs([
    { name: site.author, path: translatePath('/') },
    { name: t('notes.title'), path: translatePath('/notes') },
    { name: note.data.title, path },
  ]),
];
---

<BaseLayout title={note.data.title} description={note.data.description} ogType="article" ogImage={ogImage} article={article} hasAlternates={false} schema={schema}>
  <Header hasAlternates={false} />
  <main id="main-content" class="grow">
    <section class="pt-16 pb-16 md:pt-20 md:pb-20">
      <div class="max-w-3xl mx-auto px-4">
        <article>
          <header class="mb-10">
            <p class="text-sm text-gray-500">
              <time datetime={isoDate(shownDate)}>{formatDate(shownDate, lang)}</time>
              {writtenDate && (
                <span data-note-published> · {t('notes.published')} <time datetime={isoDate(pubDate)}>{formatDate(pubDate, lang)}</time></span>
              )}
            </p>
            <h1 class="text-3xl font-extrabold text-gray-800 mt-3">{note.data.title}</h1>
            <div class="flex flex-wrap gap-2 mt-4">
              {note.data.tags.map((tag: string) => (
                <a href={translatePath(`/tags/${tag.toLowerCase()}`)} data-tag-chip class="inline-flex min-h-7 min-w-6 items-center justify-center px-2 text-xs rounded bg-gray-100 text-gray-600 border border-gray-200 hover:bg-cyan-700 hover:text-white hover:border-cyan-700 transition-colors">
                  {tag}
                </a>
              ))}
            </div>
          </header>
          {note.data.supersededBy && (
            <NoteSupersededNotice supersededBy={note.data.supersededBy} lang={lang} />
          )}
          <div class="prose prose-lg max-w-none prose-headings:font-extrabold prose-headings:text-gray-800 prose-p:text-gray-600 prose-li:text-gray-600 prose-strong:text-gray-800">
            <Content />
          </div>
        </article>
      </div>
    </section>

    <NoteClosing lang={lang} />

    <nav aria-label={t('note.navLabel')} class="py-12 md:py-16 border-t border-gray-200">
      <div class="max-w-3xl mx-auto px-4">
        <div class="flex items-center justify-between gap-4">
          {prev ? (
            <a href={translatePath(`/notes/${prev.id}`)} class="group flex-1 min-w-0">
              <span class="text-xs text-gray-500">&larr; {t('note.prev')}</span>
              <span class="block text-sm font-bold text-gray-700 group-hover:text-cyan-700 transition-colors truncate mt-0.5">{prev.title}</span>
            </a>
          ) : <div class="flex-1" />}
          <a href={translatePath('/notes')} class="text-xs text-gray-500 hover:text-cyan-700 transition-colors shrink-0 px-2">{t('notes.all')}</a>
          {next ? (
            <a href={translatePath(`/notes/${next.id}`)} class="group flex-1 min-w-0 text-right">
              <span class="text-xs text-gray-500">{t('note.next')} &rarr;</span>
              <span class="block text-sm font-bold text-gray-700 group-hover:text-cyan-700 transition-colors truncate mt-0.5">{next.title}</span>
            </a>
          ) : <div class="flex-1" />}
        </div>
      </div>
    </nav>
  </main>
  <Footer />
</BaseLayout>
