---
/**
 * The Four Deterministic Containment Pillars (WEB-091).
 *
 * Explains how the platform binds and governs stochastic autonomous models
 * through deterministic OS primitives and verification gates.
 */
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getLocale, useTranslations } from '../i18n/utils';

interface Props {
  number: string;
}

const { number } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);

const badgeColors: Record<string, string> = {
  Isolation: 'bg-accent-50 text-accent-700 border-accent-200',
  Security: 'bg-danger-50 text-danger-700 border-danger-200',
  Safety: 'bg-warn-50 text-warn-700 border-warn-200',
  Verification: 'bg-ok-50 text-ok-700 border-ok-200',
};

const pillars = [
  {
    badge: 'Isolation',
    title: t('ai.pillars.p1.title'),
    description: t('ai.pillars.p1.desc'),
    items: [
      t('ai.pillars.p1.i1'),
      t('ai.pillars.p1.i2'),
      t('ai.pillars.p1.i3'),
    ]
  },
  {
    badge: 'Security',
    title: t('ai.pillars.p2.title'),
    description: t('ai.pillars.p2.desc'),
    items: [
      t('ai.pillars.p2.i1'),
      t('ai.pillars.p2.i2'),
      t('ai.pillars.p2.i3'),
    ]
  },
  {
    badge: 'Safety',
    title: t('ai.pillars.p3.title'),
    description: t('ai.pillars.p3.desc'),
    items: [
      t('ai.pillars.p3.i1'),
      t('ai.pillars.p3.i2'),
      t('ai.pillars.p3.i3'),
    ]
  },
  {
    badge: 'Verification',
    title: t('ai.pillars.p4.title'),
    description: t('ai.pillars.p4.desc'),
    items: [
      t('ai.pillars.p4.i1'),
      t('ai.pillars.p4.i2'),
      t('ai.pillars.p4.i3'),
    ]
  }
];
---

<Section padding="py-14" data-ai-section="pillars">
  <SectionHeading number={number} label={t('ai.pillars.heading')} margin="mb-2" />
  <p class="text-sm text-ink-500 mb-8 max-w-2xl">
    {t('ai.pillars.sub')}
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {pillars.map((pillar) => {
      const colorClass = badgeColors[pillar.badge] || 'bg-panel-100 text-panel-700 border-panel-200';
      return (
        <div class="p-6 rounded-xl border border-ink-200 bg-white shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class:list={['text-xs font-mono px-2.5 py-0.5 rounded-full border font-medium', colorClass]}>
                {pillar.badge}
              </span>
            </div>
            <h3 class="text-base font-bold text-ink-900 mb-2">
              {pillar.title}
            </h3>
            <p class="text-sm text-ink-600 leading-relaxed mb-6">
              {pillar.description}
            </p>
          </div>
          <ul class="space-y-2 border-t border-ink-100 pt-4 text-xs text-ink-600 font-mono">
            {pillar.items.map((item) => (
              <li class="flex items-center gap-2">
                <span class="text-accent-700 font-bold">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</Section>
