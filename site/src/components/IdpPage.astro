---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import LabDiagram from './LabDiagram.astro';
import LabServices from './LabServices.astro';
import LabInfra from './LabInfra.astro';
import LabProvenance from './LabProvenance.astro';
import LabAutomations from './LabAutomations.astro';
import { platform } from '../data/platform';
import { getLocale, useTranslations } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('idp.title')} — Manu Lorente`}
  description={t('idp.description')}
>
  <Header />

  <main id="main-content" class="flex-grow pb-16">
    <!-- Hero / Title Section -->
    <section class="max-w-4xl mx-auto px-4 pt-10 pb-8">
      <p class="text-sm font-medium text-gray-500 tracking-widest uppercase mb-3">
        <span class="text-cyan-700">[ 00 /</span> {t('idp.eyebrow')} <span class="text-cyan-700">]</span>
      </p>

      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
          {t('idp.title')}
        </h1>
        <div class="flex items-center gap-2 shrink-0 text-xs font-mono">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            {platform.cluster.gitops}
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-700 border border-gray-200">
            {platform.cluster.version}
          </span>
        </div>
      </div>

      <p class="text-lg text-gray-600 mt-4 leading-relaxed max-w-3xl">
        {t('idp.description')}
      </p>
    </section>

    <!-- SECTION 1: Platform Purpose & Storytelling -->
    <Section padding="py-10">
        <SectionHeading number="01" label={t('idp.story.heading')} margin="mb-6" />

        <div class="space-y-4 text-base text-gray-700 leading-relaxed max-w-3xl">
          <p>{t('idp.story.p1')}</p>
          <p>{t('idp.story.p2')}</p>
        </div>

        <!-- 3 Core Architectural Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
          <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
            <div class="text-xs font-mono font-semibold text-cyan-800 uppercase tracking-wider mb-1">
              01 · {t('idp.pillar.gitops')}
            </div>
            <p class="text-xs text-gray-600 mt-2 leading-relaxed font-sans">
              {t('idp.pillar.gitopsDesc')}
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
            <div class="text-xs font-mono font-semibold text-cyan-800 uppercase tracking-wider mb-1">
              02 · {t('idp.pillar.privacy')}
            </div>
            <p class="text-xs text-gray-600 mt-2 leading-relaxed font-sans">
              {t('idp.pillar.privacyDesc')}
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
            <div class="text-xs font-mono font-semibold text-cyan-800 uppercase tracking-wider mb-1">
              03 · {t('idp.pillar.memory')}
            </div>
            <p class="text-xs text-gray-600 mt-2 leading-relaxed font-sans">
              {t('idp.pillar.memoryDesc')}
            </p>
          </div>
        </div>
    </Section>


    <LabServices number="02" />

    <LabInfra number="03" />

    <LabDiagram
      name="topology"
      number="04"
      label={t('lab.diagram.topology.heading')}
      caption={t('lab.diagram.topology.caption')}
      legend={t('lab.diagram.topology.legend')}
    />

    <LabDiagram
      name="flows"
      number="05"
      label={t('lab.diagram.flows.heading')}
      caption={t('lab.diagram.flows.caption')}
      legend={t('lab.diagram.flows.legend')}
    />

    <LabAutomations number="06" />

    <!-- SECTION 5: Service Level Objectives (SLOs) & Reliability -->
    <Section padding="py-10">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
          <SectionHeading number="07" label={t('idp.slos.heading')} />
          <span class="text-xs font-mono text-emerald-700 font-semibold">{t('idp.d.90DaySlaTarget')}</span>
        </div>
        <p class="text-xs text-gray-500 mb-6">{t('idp.slos.sub')}</p>

        <!-- 90-day availability, as recorded by Uptime Kuma at build time -->
        <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
              <span class="font-bold text-gray-900 text-sm font-mono">{t('idp.d.90DayPlatformAvailability')}</span>
            </div>
            <span class="font-mono font-bold text-emerald-700 text-sm">{platform.cluster.uptime}</span>
          </div>
          <p class="text-[11px] font-mono text-gray-500">{t('idp.snapshot')}</p>
        </div>

        <!-- Grid of SLI vs SLO Targets -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 font-mono text-xs mt-4">
          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] text-gray-500 uppercase tracking-wider block mb-1">{t('idp.d.availabilitySlo')}</span>
            <div class="flex items-baseline justify-between">
              <span class="text-xl font-bold text-gray-900">{platform.cluster.uptime}</span>
              <span class="text-[10px] text-gray-500">{t('idp.d.target995')}</span>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block mt-1">● NOMINAL (Uptime Kuma)</span>
          </div>

          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] text-gray-500 uppercase tracking-wider block mb-1">{t('idp.d.edgeIngressP95')}</span>
            <div class="flex items-baseline justify-between">
              <span class="text-xl font-bold text-gray-900">~42ms</span>
              <span class="text-[10px] text-gray-500">{t('idp.d.targetLt100ms')}</span>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block mt-1">● TRAEFIK + CLOUDFLARE</span>
          </div>

          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] text-gray-500 uppercase tracking-wider block mb-1">{t('idp.d.gitopsDriftLoop')}</span>
            <div class="flex items-baseline justify-between">
              <span class="text-xl font-bold text-gray-900">{platform.metrics.gitopsSyncLoop}</span>
              <span class="text-[10px] text-gray-500">{t('idp.d.targetLt60s')}</span>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block mt-1">● ARGO CD RECONCILER</span>
          </div>

          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] text-gray-500 uppercase tracking-wider block mb-1">{t('idp.d.cudaEdgeTtft')}</span>
            <div class="flex items-baseline justify-between">
              <span class="text-xl font-bold text-gray-900">{platform.metrics.inferenceLatency}</span>
              <span class="text-[10px] text-gray-500">{t('idp.d.targetLt50s')}</span>
            </div>
            <span class="text-[10px] text-purple-700 font-semibold block mt-1">● JETSON NANO (QWEN 1.5B)</span>
          </div>
        </div>
    </Section>

    <!-- SECTION 6: Client-Side Health Verification -->
    <Section
      padding="py-10"
      data-idp-console
      data-probe-i18n={JSON.stringify({
        running: t('idp.probe.running'),
        checking: t('idp.probe.checking'),
        probing: t('idp.probe.probing'),
        reachable: t('idp.probe.reachable'),
        unreachable: t('idp.probe.unreachable'),
        result: t('idp.probe.result'),
        summary: t('idp.probe.summary'),
        lastRun: t('idp.probe.lastRun'),
      })}
    >
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 mb-4">
          <div>
            <SectionHeading number="08" label={t('idp.probe.heading')} />
            <p class="text-xs text-gray-500 mt-1">{t('idp.probe.sub')}</p>
          </div>
          <button
            type="button"
            data-action="run-probe"
            class="inline-flex items-center gap-1.5 bg-gray-900 hover:bg-gray-800 text-white text-xs font-mono font-medium px-3.5 py-2 rounded-lg transition-all shadow-sm active:scale-95 cursor-pointer self-start sm:self-auto"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>{t('idp.probe.btn')}</span>
          </button>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 font-mono text-xs text-slate-300 shadow-md">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 text-slate-400 text-[11px]">
            <span>{t('idp.d.idpProbeRunnerBrowser')}</span>
            <span data-probe-status>{t('idp.d.ready')}</span>
          </div>

          <div
            data-probe-log
            class="py-3 space-y-1.5 min-h-[120px] max-h-[220px] overflow-y-auto font-mono text-[12px] select-text"
          >
            <p class="text-slate-500">{t('idp.d.readyToVerifyLive')}</p>
          </div>

          <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-500">
            <span data-probe-timestamp>{t('idp.probe.timestamp')}: --</span>
            <span class="text-emerald-400 font-medium">{t('idp.d.nonBlockingCorsCheck')}</span>
          </div>
        </div>
    </Section>

    <LabProvenance />
  </main>

  <Footer />
</BaseLayout>

<script>
  import { platform } from '../data/platform';

  interface ProbeResult {
    slug: string;
    url: string;
    status: number | string;
    latencyMs: number;
    ok: boolean;
  }

  // --- HEALTH PROBE RUNNER ---
  function getTimestamp(): string {
    return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  function appendLog(root: Element, message: string, colorClass: string = 'text-slate-300'): void {
    const logContainer = root.querySelector('[data-probe-log]');
    if (!logContainer) return;
    const p = document.createElement('p');
    p.className = colorClass;
    p.textContent = message;
    logContainer.appendChild(p);
    logContainer.scrollTop = logContainer.scrollHeight;
  }

  async function probeEndpoint(slug: string, url: string): Promise<ProbeResult> {
    const t0 = performance.now();
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 4000);

    try {
      const response = await fetch(url, {
        method: 'GET',
        mode: 'no-cors',
        cache: 'no-store',
        signal: controller.signal,
      });
      clearTimeout(timeoutId);
      const latencyMs = Math.round(performance.now() - t0);
      // no-cors yields an opaque response: the request completed, but the HTTP
      // status is unreadable from the browser. Reachability is all we can claim.
      void response;
      return {
        slug,
        url,
        status: 'REACHABLE',
        latencyMs,
        ok: true,
      };
    } catch (err: any) {
      clearTimeout(timeoutId);
      const latencyMs = Math.round(performance.now() - t0);
      const isAbort = err.name === 'AbortError';
      return {
        slug,
        url,
        status: isAbort ? 'TIMEOUT' : 'UNREACHABLE',
        latencyMs: latencyMs > 0 ? latencyMs : 999,
        ok: false,
      };
    }
  }

  async function runAllProbes(): Promise<void> {
    const root = document.querySelector('[data-idp-console]');
    if (!root) return;

    const msg = JSON.parse((root as HTMLElement).dataset.probeI18n || '{}');
    const btn = root.querySelector('[data-action="run-probe"]') as HTMLButtonElement | null;
    const statusEl = root.querySelector('[data-probe-status]');
    const timestampEl = root.querySelector('[data-probe-timestamp]');
    const logContainer = root.querySelector('[data-probe-log]');

    if (btn) btn.disabled = true;
    if (statusEl) {
      statusEl.textContent = msg.running;
      statusEl.className = 'text-[11px] text-cyan-400 font-semibold animate-pulse';
    }
    if (logContainer) logContainer.innerHTML = '';

    const publicServices = platform.services.filter((s) => s.isPublic);
    appendLog(root, `[${getTimestamp()}] ${msg.checking.replace('{n}', String(publicServices.length))}`, 'text-cyan-400');

    let totalLatency = 0;
    let reachableCount = 0;

    for (const service of publicServices) {
      const targetUrl = service.healthEndpoint || service.url;
      if (!targetUrl) continue;
      appendLog(root, `[${getTimestamp()}] ${msg.probing} ${service.name} (${targetUrl})...`, 'text-slate-400');
      const result = await probeEndpoint(service.slug, targetUrl);

      totalLatency += result.latencyMs;
      if (result.ok) reachableCount++;

      const logColor = result.ok ? 'text-emerald-400' : 'text-amber-400';
      const verdict = result.ok ? msg.reachable : msg.unreachable;
      appendLog(root, `[${getTimestamp()}]  ↳ ${service.name}: ${verdict} (${result.latencyMs}ms)`, logColor);
    }

    const avgLatency = Math.round(totalLatency / (publicServices.length || 1));
    const summary = msg.summary
      .replace('{n}', String(reachableCount))
      .replace('{m}', String(publicServices.length))
      .replace('{ms}', String(avgLatency));

    appendLog(root, `[${getTimestamp()}] ${msg.result}: ${summary}`, 'text-cyan-300 font-bold');

    if (statusEl) {
      statusEl.textContent = summary;
      statusEl.className = 'text-[11px] text-emerald-400 font-semibold';
    }
    if (timestampEl) {
      timestampEl.textContent = `${msg.lastRun}: ${getTimestamp()}`;
    }
    if (btn) btn.disabled = false;
  }

  // --- INITIALIZATION ---

  const probeBtn = document.querySelector('[data-action="run-probe"]');
  probeBtn?.addEventListener('click', runAllProbes);
  setTimeout(runAllProbes, 800);
</script>
