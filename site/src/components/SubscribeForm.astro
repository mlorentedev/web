---
// The form keeps `novalidate`: the submit handler is the single place that decides
// whether a request goes out, and it now checks the consent box explicitly. Turning
// native validation back on would give one form two different error surfaces.
import { site } from '../data/site';
import type { Lang } from '../i18n/ui';
import { getLocale, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  formId: string;
  tag: string;
  utmSource?: string;
  placeholder?: string;
  buttonText: string;
  successText?: string;
  errorText?: string;
  consentText?: string;
  lang?: Lang;
}

const {
  formId,
  tag,
  utmSource = 'landing_page',
  buttonText,
  lang = getLocale(Astro.currentLocale),
} = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const placeholder = Astro.props.placeholder ?? t('subscribe.placeholder');
const successText = Astro.props.successText ?? t('subscribe.successText');
const errorText = Astro.props.errorText ?? t('subscribe.errorText');
const consentText = Astro.props.consentText ?? t('subscribe.consentText');
const privacyHref = translatePath('/legal/privacy');
---

<div class="not-prose bg-cyan-700 text-white p-4 rounded-md max-w-xs mx-auto">
  <form
    id={formId}
    class="flex flex-col gap-4"
    data-api-url={`${site.api.baseUrl}/api/subscribe`}
    data-tag={tag}
    data-utm-source={utmSource}
    data-success-text={successText}
    data-error-text={errorText}
    data-consent-text={consentText}
    data-button-success={t('subscribe.buttonSuccess')}
    data-network-error={t('subscribe.networkError')}
    novalidate
  >
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={placeholder}
      class="w-full p-2 text-cyan-700 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-cyan-300"
      aria-label="Email"
    />
    <button
      type="submit"
      class="w-full px-4 py-2.5 bg-white text-cyan-700 border border-transparent rounded-md text-sm font-medium hover:bg-cyan-700 hover:text-white hover:border-white transition-colors focus:outline-none focus:ring-2 focus:ring-white"
    >
      {buttonText}
    </button>
    <div class="flex justify-center items-center text-center">
      <input type="checkbox" id={`privacy-${formId}`} name="privacy_policy" class="mr-2" required />
      <label for={`privacy-${formId}`} class="text-xs text-white">
        {t('subscribe.consentPrefix')} <a href={privacyHref} target="_blank" class="text-white underline">{t('subscribe.privacyPolicy')}</a>
      </label>
    </div>
    <p class="subscribe-msg text-xs text-center hidden"></p>
  </form>
</div>

<script>
  document.querySelectorAll('form[data-api-url]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      const msg = f.querySelector('.subscribe-msg') as HTMLElement;
      const button = f.querySelector('button[type="submit"]') as HTMLButtonElement;
      const email = new FormData(f).get('email') as string;
      const consentBox = f.querySelector('input[name="privacy_policy"]') as HTMLInputElement | null;

      const fail = (text: string, focus?: HTMLElement | null) => {
        if (msg) {
          msg.textContent = text;
          msg.className = 'subscribe-msg text-xs text-center text-red-200';
        }
        focus?.focus();
      };

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        fail(f.dataset.errorText || 'Invalid email');
        return;
      }

      // `novalidate` on the form disables the checkbox's native `required`, so
      // without this check the box was decorative: a visitor could subscribe
      // without ticking it and nothing downstream ever knew.
      if (!consentBox || !consentBox.checked) {
        fail(f.dataset.consentText || 'Please accept the privacy policy', consentBox);
        return;
      }

      button.disabled = true;
      button.textContent = '...';

      try {
        const res = await fetch(f.dataset.apiUrl!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            tags: [f.dataset.tag],
            utm_source: f.dataset.utmSource,
            // The API's SubscriptionRequest does not model this yet, so Gin binds
            // and discards it. Sent regardless: the client half of the contract is
            // this repo's to hold, and the field has to exist in the request before
            // the API can be asked to record it (kubelab side, tracked separately).
            privacy_policy: true,
          }),
        });

        if (res.status === 201 || res.status === 409) {
          if (msg) {
            msg.textContent = f.dataset.successText || 'Done!';
            msg.className = 'subscribe-msg text-xs text-center text-cyan-200';
          }
          button.textContent = f.dataset.buttonSuccess || 'Received';
        } else {
          throw new Error(`Status ${res.status}`);
        }
      } catch {
        if (msg) {
          msg.textContent = f.dataset.networkError || 'Error. Please try again.';
          msg.className = 'subscribe-msg text-xs text-center text-red-200';
        }
        button.disabled = false;
        button.textContent = f.querySelector('button')?.textContent || 'Retry';
      }
    });
  });
</script>
