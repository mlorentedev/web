---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { experience, localizeExperience } from '../data/experience';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props {
  /** Current UI language — selects role/location copy and the "Present" label. */
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = experience.map((e) => localizeExperience(e, lang, t('experience.present')));

// The bio is prose, so it lives in `content/pages/<lang>-bio.mdx` where it can be
// edited as markdown rather than as an i18n string (WEB-137). Every figure in it
// must already be in `data/experience.ts`.
const [bio] = await getCollection('pages', ({ data }: CollectionEntry<'pages'>) => data.page === 'bio' && data.lang === lang);
const { Content: Bio } = await render(bio);
---

<Section data-experience>
  <SectionHeading label={t('home.experience')} margin="mb-8" />
  <div data-bio class="prose prose-base max-w-3xl mb-10 prose-p:text-ink-700 prose-p:leading-relaxed">
    <Bio />
  </div>
  <ol class="space-y-6">
      {entries.map((e) => (
        <li data-role class="flex flex-col sm:flex-row sm:gap-6">
          <span class="text-sm text-gray-500 tabular-nums shrink-0 sm:w-28 mb-1 sm:mb-0">{e.period}</span>
          <div class="sm:border-l sm:border-gray-100 sm:pl-6 grow">
            <h3 class="text-base leading-snug">
              <span class="font-bold text-gray-800">{e.role}</span>
              <span class="text-gray-500"> · {e.company} · {e.location}</span>
            </h3>
            <p class="text-sm text-gray-600 mt-1 leading-relaxed">{e.highlight}</p>
          </div>
        </li>
      ))}
  </ol>
</Section>
