---
// GDPR cookie-consent banner. Shown only until the user decides; the choice persists
// in localStorage. Accept → load GA4 (window.loadGA from Analytics.astro). Reject →
// nothing. Cloudflare Web Analytics is cookieless and is not affected by this choice.
import { getLocale, useTranslations } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const privacyUrl = '/es/legal/privacy';
---

<div
  id="cookie-banner"
  class="fixed bottom-0 inset-x-0 z-50 bg-cyan-900 text-white text-sm px-4 py-3 shadow-lg"
  hidden
>
  <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="text-center sm:text-left">
      {t('cookie.text')}
      <a href={privacyUrl} class="underline hover:text-cyan-200">{t('cookie.policy')}</a>
    </p>
    <div class="flex gap-2 shrink-0">
      <button
        id="cookie-reject"
        class="px-3 py-1.5 rounded border border-white/40 hover:bg-white/10 transition-colors"
      >
        {t('cookie.reject')}
      </button>
      <button
        id="cookie-accept"
        class="px-3 py-1.5 rounded bg-white text-cyan-900 font-medium hover:bg-cyan-100 transition-colors"
      >
        {t('cookie.accept')}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'cookie-consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;

    // Storage access *throws* where the user blocks all cookies, inside sandboxed
    // iframes, and in private-mode-class contexts. Reading it unguarded used to be
    // the third statement here, so a throw aborted the whole IIFE: the banner was
    // never unhidden and the click handlers were never attached, which made consent
    // impossible to give in exactly the browsers configured to care about it.
    //
    // Guarded, a storage failure degrades to a choice that holds for the page
    // instead of a dead banner. sessionStorage is not the fallback — it throws in
    // the same contexts — so the fallback is a variable.
    var memory = null;

    function read() {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        return memory;
      }
    }

    function write(value) {
      memory = value;
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {
        /* Session-only. The choice still applies here; it just will not survive. */
      }
    }

    function show() {
      banner.hidden = false;
    }

    function hide() {
      banner.hidden = true;
    }

    if (!read()) show(); // undecided visitors only

    var accept = document.getElementById('cookie-accept');
    if (accept) {
      accept.addEventListener('click', function () {
        write('granted');
        hide();
        // Ordered after write() but independent of it: persisting the choice can
        // fail and consent still has to take effect on this page.
        if (window.loadGA) window.loadGA();
      });
    }

    var reject = document.getElementById('cookie-reject');
    if (reject) {
      reject.addEventListener('click', function () {
        write('denied');
        hide();
      });
    }

    // Withdrawal. GDPR requires taking consent back to be as easy as giving it,
    // and until now the only route was DevTools. The footer control reopens the
    // banner whatever the stored choice is, which is why the read() above can no
    // longer be the only path to showing it.
    var managers = document.querySelectorAll('[data-cookie-manage]');
    for (var i = 0; i < managers.length; i++) {
      managers[i].addEventListener('click', function (e) {
        e.preventDefault();
        show();
        // Move the caret into the banner, or a keyboard visitor triggers it from
        // the footer and lands nowhere.
        if (reject) reject.focus();
      });
    }
  })();
</script>
