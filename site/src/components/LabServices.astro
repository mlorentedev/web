---
/**
 * The Lab's Services section (WEB-080, AC1 + AC3).
 *
 * Renders every entry of `platform.services` — no hand-written rows — and makes
 * each one's access boundary explicit, which is What §2's actual requirement:
 * a catalogue that lists a service without saying who can reach it is a list of
 * names.
 *
 * ## Static, and that is a requirement rather than a preference
 *
 * `proposal.md` Out of scope: "This spec delivers layer 0: **static at build,
 * zero JS**." The section this replaces had four client-side filter tabs over
 * fourteen rows, and one of them — Staging — matched nothing at all, because
 * `env` only ever holds `common` or `prod`. Grouping by category at build time
 * says the same thing without shipping a script.
 *
 * ## Colour
 *
 * The access boundary is deliberately **not** painted in `ok`/`warn`/`danger`.
 * Those are reserved for real status, by the mapping decided on #251: a private
 * service is not a degraded one, it is simply not addressed to the reader.
 * `public` takes `accent` because it is a link you can follow; `mesh` takes the
 * neutral `panel`. Status keeps the status families.
 */
import ServiceIcon from './ServiceIcon.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { platform, type PlatformService } from '../data/platform';
import { getLocale, useTranslations } from '../i18n/utils';

interface Props {
  /** Section number in the page's sequence, e.g. "03". */
  number: string;
}

const { number } = Astro.props;

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const isEs = lang === 'es';

/**
 * Category order is fixed here rather than taken from the data's insertion
 * order, so adding a service cannot silently reorder the page.
 */
const CATEGORY_ORDER: PlatformService['category'][] = [
  'Core Gateway',
  'AI & Inference',
  'GitOps & Delivery',
  'Observability',
  'Storage & Data',
];

const grouped = CATEGORY_ORDER.map((category) => ({
  category,
  label: isEs
    ? platform.services.find((s) => s.category === category)?.categoryEs ?? category
    : category,
  services: platform.services.filter((s) => s.category === category),
})).filter((group) => group.services.length > 0);

/** Real status, in the status families. Access lives elsewhere, on purpose. */
const STATUS_DOT: Record<PlatformService['status'], string> = {
  operational: 'bg-ok-500',
  degraded: 'bg-warn-500',
  maintenance: 'bg-observe-500',
};

/** Translated, for the same reason as in `LabInfra.astro`: status is prose. */
const STATUS_LABEL: Record<PlatformService['status'], string> = {
  operational: t('lab.status.operational'),
  degraded: t('lab.status.degraded'),
  maintenance: t('lab.status.maintenance'),
};
---

<Section padding="py-10" data-lab-section="services">
  <SectionHeading number={number} label={t('lab.services.heading')} margin="mb-3" />

  <p class="text-sm text-ink-600 leading-relaxed max-w-3xl mb-2">
    {t('lab.services.intro')}
  </p>
  <p class="text-xs font-mono text-ink-500 mb-8">
    {t('lab.services.count')
      .replace('{n}', String(platform.services.length))
      .replace('{total}', String(platform.cluster.totalServices))}
  </p>

  <div
    class="w-full overflow-x-auto border border-ink-200 rounded-lg shadow-xs bg-white"
    tabindex="0"
    role="region"
    aria-label={t('lab.services.heading')}
  >
    <table class="ep-table w-full text-left border-collapse font-mono text-xs">
      <thead class="bg-ink-900 text-ink-100 border-b border-ink-800">
        <tr class="uppercase tracking-wider text-xs">
          <th scope="col" class="py-2.5 px-3 w-8 text-center">
            <span class="sr-only">{t('lab.services.th.status')}</span>
          </th>
          <th scope="col" class="py-2.5 px-3 font-semibold whitespace-nowrap">
            {t('lab.services.th.service')}
          </th>
          <th scope="col" class="py-2.5 px-3 font-semibold whitespace-nowrap">
            {t('lab.services.th.category')}
          </th>
          <th scope="col" class="py-2.5 px-3 font-semibold whitespace-nowrap">
            {t('lab.services.th.access')}
          </th>
          <th scope="col" class="py-2.5 px-3 font-semibold whitespace-nowrap">
            {t('lab.services.th.node')}
          </th>
          <th scope="col" class="py-2.5 px-3 font-semibold whitespace-nowrap">
            {t('lab.services.th.endpoint')}
          </th>
          <th scope="col" class="py-2.5 px-3 font-semibold w-80">
            {t('lab.services.th.description')}
          </th>
        </tr>
      </thead>

      {grouped.map((group) => (
        <tbody class="divide-y divide-ink-100">
          <tr class="bg-ink-100/70 font-mono text-xs font-semibold text-ink-700 border-t border-b border-ink-200">
            <th
              scope="rowgroup"
              colspan="7"
              class="py-1.5 px-3 text-left font-semibold uppercase tracking-widest text-ink-700"
            >
              // {group.label}
            </th>
          </tr>
          {group.services.map((svc) => (
            <tr
              data-service-row={svc.env}
              data-service-slug={svc.slug}
              data-access={svc.isPublic ? 'public' : 'mesh'}
              class="hover:bg-ink-50/80 transition-colors"
            >
              <td class="py-2.5 px-3 text-center whitespace-nowrap">
                <span
                  class:list={['inline-block w-2 h-2 rounded-full', STATUS_DOT[svc.status]]}
                  title={STATUS_LABEL[svc.status]}
                ></span>
              </td>

              <td class="py-2.5 px-3 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <ServiceIcon slug={svc.slug} class="w-4 h-4 shrink-0 text-ink-700" />
                  <span class="font-semibold text-ink-900 font-sans text-sm">{svc.name}</span>
                </div>
              </td>

              <td class="py-2.5 px-3 whitespace-nowrap">
                <span class="inline-block px-1.5 py-0.5 rounded text-xs font-medium bg-panel-100 text-panel-800 border border-panel-200">
                  {isEs ? svc.categoryEs : svc.category}
                </span>
              </td>

              <td class="py-2.5 px-3 whitespace-nowrap">
                {svc.isPublic ? (
                  <span class="inline-block px-1.5 py-0.5 rounded text-xs font-semibold bg-accent-50 text-accent-800 border border-accent-200">
                    {t('lab.access.public')}
                  </span>
                ) : (
                  <span class="inline-block px-1.5 py-0.5 rounded text-xs font-semibold bg-panel-100 text-panel-700 border border-panel-200">
                    {t('lab.access.mesh')}
                  </span>
                )}
              </td>

              <td class="py-2.5 px-3 whitespace-nowrap">
                <span class="font-mono text-xs uppercase font-medium text-ink-600 bg-ink-100 px-1.5 py-0.5 rounded border border-ink-200">
                  {svc.node}
                </span>
              </td>

              <td class="py-2.5 px-3 whitespace-nowrap font-mono text-xs">
                {svc.url ? (
                  <a
                    href={svc.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent-700 hover:text-accent-900 font-semibold hover:underline inline-flex items-center gap-1"
                  >
                    <span>{svc.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
                    <span aria-hidden="true">&#8599;</span>
                  </a>
                ) : (
                  <span class="text-ink-400 select-none">—</span>
                )}
              </td>

              <td class="py-2.5 px-3 text-ink-600 font-sans text-xs leading-relaxed">
                <p>{isEs ? svc.descriptionEs : svc.description}</p>
                {svc.tech && svc.tech.length > 0 && (
                  <div class="mt-1 flex flex-wrap gap-1">
                    {svc.tech.map((tech) => (
                      <span class="font-mono text-xs text-ink-700 bg-ink-100/60 px-1.5 py-0.5 rounded border border-ink-200/60">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
</Section>
