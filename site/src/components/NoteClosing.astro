---
/**
 * The exit at the end of a note.
 *
 * Sixteen notes against one homepage means most arrivals land here, from a
 * search engine, and until now the only way out was previous/next/all. The IA
 * audit counted exactly two places to contact Manu on the whole site — the
 * header and the hero — neither of which a reader who scrolled to the bottom of
 * a note has in front of them.
 *
 * Deliberately not a positioning statement: the hero copy is still being decided
 * (#182), and a claim baked in here would have to be kept in sync with it. This
 * says what the notes are and offers the two things that actually work today —
 * the contact page and the feed.
 */
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<aside class="py-12 md:py-14 border-t border-gray-200" aria-labelledby="note-closing-heading">
  <div class="max-w-3xl mx-auto px-4">
    <h2 id="note-closing-heading" class="text-xs font-mono uppercase tracking-widest text-cyan-700">
      {t('note.closing.eyebrow')}
    </h2>

    <p class="mt-3 text-gray-600 leading-relaxed">
      {t('note.closing.body')}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href={translatePath('/contact')}
        class="inline-flex items-center gap-2 text-sm font-bold text-cyan-700 hover:text-cyan-800 focus:outline-none focus:ring-2 focus:ring-cyan-600/40 rounded px-1 -mx-1 transition-colors group"
      >
        {t('note.closing.contact')}
        <span class="font-mono transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
      </a>

      {/* The feed is absolute on purpose: a reader may be in the Spanish tree,
          and there is one feed, built from the English notes. */}
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-600/40 rounded px-1 -mx-1 transition-colors"
      >
        {t('note.closing.feed')}
      </a>
    </div>
  </div>
</aside>
