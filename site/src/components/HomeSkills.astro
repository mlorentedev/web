---
// What Manu does, by layer (#499): terms to scan, then a sentence or two on the
// work that proves them, linked inline. Each layer opens on a label key in its
// own hue and its terms read as chips, the way platform tools label things
// (ADR-060). The key carries the meaning, the hue only groups. The layers live
// in `data/skills.ts`, so both locales list the same ones. The GitHub chart
// closes the section: the activity behind the layers, linked to the profile.
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { languages, layersFor, type Tone } from '../data/skills';
import { ghchartSrc, site } from '../data/site';
import { localize, projects } from '../data/portfolio';
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const link = (href: string) => (href.startsWith('/') ? translatePath(href) : href);

// A layer's `built/` line: the project by its portfolio title, linked to its
// public repository, with the metric /projects already shows (#589).
const project = (title?: string) => {
  const found = title ? projects.find((p) => p.en.title === title) : undefined;
  if (title && !found?.github) throw new Error(`skills: built project "${title}" has no portfolio entry with a repository`);
  return found && { ...localize(found, lang), github: found.github as string };
};

// Whole class names, so Tailwind sees them at build time.
const label: Record<Tone, string> = {
  accent: 'bg-accent-50 text-accent-800 ring-accent-200',
  emerald: 'bg-ok-50 text-ok-800 ring-ok-200',
  purple: 'bg-observe-50 text-observe-800 ring-observe-200',
  amber: 'bg-warn-50 text-warn-800 ring-warn-200',
  rose: 'bg-danger-50 text-danger-800 ring-danger-200',
};
const dot: Record<Tone, string> = {
  accent: 'bg-accent-500',
  emerald: 'bg-ok-500',
  purple: 'bg-observe-500',
  amber: 'bg-warn-500',
  rose: 'bg-danger-500',
};
---

<Section id="skills" data-home-block="skills">
  <SectionHeading label={t('home.skills')} margin="mb-6" />
  <dl data-skills class="max-w-3xl divide-y divide-ink-100 border-y border-ink-100">
    {layersFor(lang).map(({ key, tone, name, terms, story: [before, words, after], href, built }) => (
      <div data-skill data-key={key} class="grid gap-2 py-4 md:grid-cols-[11rem_1fr] md:gap-6">
        <dt>
          <span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-xs font-medium ring-1 ring-inset', label[tone]]}>
            <span class:list={['size-1.5 rounded-full', dot[tone]]} aria-hidden="true"></span>{key}
          </span>
          <span class="sr-only">{name}</span>
        </dt>
        <dd>
          <ul class="flex flex-wrap gap-1.5" aria-label={name}>
            {terms.map((term) => (
              <li class="rounded-md bg-ink-50 px-2 py-0.5 font-mono text-xs text-ink-700 ring-1 ring-inset ring-ink-200">{term}</li>
            ))}
          </ul>
          <p class="mt-2 text-base text-ink-700 leading-relaxed">
            {before}<a href={link(href)} class="text-accent-700 underline decoration-ink-300 hover:text-accent-800 transition-colors">{words}</a>{after}
          </p>
          {
            project(built) && (
              <p data-built class="mt-1.5 font-mono text-sm text-ink-600">
                <span translate="no">
                  <span class="text-ink-500">built/</span>
                  <a href={project(built)!.github} class="text-accent-700 underline decoration-ink-300 hover:text-accent-800 transition-colors">{project(built)!.title}</a>
                </span>
                <span aria-hidden="true"> · </span>
                <span>{project(built)!.metric}</span>
              </p>
            )
          }
        </dd>
      </div>
    ))}
  </dl>
  <div data-languages class="max-w-3xl mt-4 flex flex-wrap items-center gap-1.5 font-mono text-xs text-ink-600">
    <span class="mr-1">{t('home.languages')}:</span>
    <ul class="contents">
      {languages.map((l) => <li class="rounded-md bg-ink-50 px-2 py-0.5 text-ink-700 ring-1 ring-inset ring-ink-200">{l}</li>)}
    </ul>
  </div>
  <figure data-activity class="max-w-3xl mt-8">
    <figcaption class="mb-2 font-mono text-xs text-ink-500">{t('home.activity')}</figcaption>
    <a href={site.social.github} class="block">
      <img src={ghchartSrc} alt={t('meta.ghchart.alt')} width="663" height="104" class="w-full hover:opacity-80 transition-opacity" loading="lazy" />
    </a>
  </figure>
</Section>
