---
// What Manu does, by layer (#499): terms to scan, then the work that proves
// them. Text only, like the timeline above it. The layers live in
// `data/skills.ts`, so both locales list the same ones.
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { languages, layersFor } from '../data/skills';
import type { Lang } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const link = (href: string) => (href.startsWith('/') ? translatePath(href) : href);
---

<Section id="skills" data-home-block="skills">
  <SectionHeading label={t('home.skills')} margin="mb-6" />
  <dl data-skills class="max-w-3xl divide-y divide-ink-100 border-y border-ink-100">
    {layersFor(lang).map(({ name, terms, proof, link: label, href }) => (
      <div data-skill class="grid gap-1 py-4 md:grid-cols-[11rem_1fr] md:gap-6">
        <dt class="text-sm font-semibold text-ink-900">{name}</dt>
        <dd>
          <p class="text-sm font-mono text-ink-700 leading-relaxed">{terms.join(' · ')}</p>
          <p class="mt-1 text-base text-ink-700 leading-relaxed">
            {proof}{' '}
            <a href={link(href)} class="text-sm text-accent-700 underline decoration-ink-300 hover:text-accent-800 transition-colors">{label}</a>
          </p>
        </dd>
      </div>
    ))}
  </dl>
  <p data-languages class="max-w-3xl mt-4 text-sm font-mono text-ink-600">{t('home.languages')}: {languages.join(' · ')}</p>
</Section>
