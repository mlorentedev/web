---
/**
 * "Notes on this" under a Lab section (#592): the notes `lab-notes.ts` maps
 * to its number, published ones only. Notes the locale has not translated (all
 * of them in Spanish, today) get one link to the English notes, as the Spanish
 * notes index does, rather than English titles in Spanish prose.
 */
import { labNotes } from '../data/lab-notes';
import { notesIn } from '../lib/locale-pages';
import { sectionNotes } from '../lib/section-notes.mjs';
import { getLocale, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  /** The section number the notes belong to, e.g. "01". */
  number: string;
}

const { number } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { notes, moreInEnglish } = sectionNotes(labNotes[number] ?? [], await notesIn(lang), await notesIn('en'));
---

{(notes.length > 0 || moreInEnglish) && (
  <div data-lab-notes={number} class="max-w-6xl mx-auto px-4 -mt-4 pb-10">
    <p class="text-sm text-ink-600">
      <span class="font-mono text-ink-500">{t('lab.notes.label')}</span>{' '}
      {notes.map((note, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={translatePath(`/notes/${note.id}`)} class="text-accent-700 hover:text-accent-800 underline">{note.data.title}</a>
        </>
      ))}
      {moreInEnglish && (
        <>
          {notes.length > 0 && <span aria-hidden="true"> · </span>}
          <a href="/notes/" hreflang="en" class="text-accent-700 hover:text-accent-800 underline">{t('lab.notes.inEnglish')}</a>
        </>
      )}
    </p>
  </div>
)}
