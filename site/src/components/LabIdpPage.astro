---
/**
 * KubeLab IDP (Internal Developer Platform) Catalog Page.
 *
 * Dedicated public platform tooling and operational catalog. Surfaces real cloud
 * spend, incident triage runbooks, perimeter security audits, and upstream dependencies.
 *
 * Designed to satisfy strict tokens-only styling (`panel-*`, `ink-*`, `accent-*`),
 * zero client JavaScript, and strict access boundary isolation (ADR-056 §3).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SectionHeading from './SectionHeading.astro';
import IdpIcon from './IdpIcon.astro';
import { idpCatalog, type IdpAccess } from '../data/idp-catalog';
import { getLocale, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const isEs = lang === 'es';

const totalItems = idpCatalog.categories.reduce((acc, cat) => acc + cat.items.length, 0);

const ACCESS_LABEL: Record<IdpAccess, string> = {
  public: t('idp.access.public'),
  mesh: t('idp.access.mesh'),
  auth: t('idp.access.auth'),
  local: t('idp.access.local'),
};

const ACCESS_BADGE: Record<IdpAccess, string> = {
  public: 'bg-accent-50 text-accent-800 border-accent-200',
  mesh: 'bg-panel-100 text-panel-700 border-panel-200',
  auth: 'bg-panel-100 text-panel-700 border-panel-200',
  local: 'bg-panel-100 text-panel-700 border-panel-200',
};
---

<BaseLayout
  title={`${t('idp.catalog.title')} — Manu Lorente`}
  description={t('idp.catalog.description')}
>
  <Header />

  <main id="main-content" class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <!-- Breadcrumb back link -->
    <div class="mb-8">
      <a
        href={translatePath('/lab')}
        class="inline-flex items-center gap-1.5 text-xs font-mono text-ink-500 hover:text-accent-700 transition-colors focus:outline-none focus:text-accent-700"
      >
        <span aria-hidden="true">&larr;</span>
        <span>{t('idp.catalog.backToLab')}</span>
      </a>
    </div>

    <!-- Hero Header -->
    <header class="mb-14 border-b border-panel-200 pb-8">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="text-xs font-mono uppercase tracking-widest text-accent-700 bg-accent-50 px-2.5 py-0.5 rounded border border-accent-200">
          {t('idp.catalog.eyebrow')}
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-ink-900 tracking-tight mb-3">
        {t('idp.catalog.title')}
      </h1>
      <p class="text-sm sm:text-base text-ink-600 max-w-3xl leading-relaxed mb-4">
        {t('idp.catalog.intro')}
      </p>
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-ink-500">
        <span class="inline-flex items-center gap-1.5 bg-panel-100 text-panel-800 px-2.5 py-1 rounded border border-panel-200">
          <span class="w-2 h-2 rounded-full bg-ok-500"></span>
          {t('idp.catalog.stats')
            .replace('{categories}', String(idpCatalog.categories.length))
            .replace('{items}', String(totalItems))}
        </span>
      </div>

      <!-- Sub-navigation tabs -->
      <nav class="flex items-center gap-2 mt-6" aria-label={t('idp.nav.sections')}>
        <a
          href={translatePath('/lab/idp')}
          aria-current="page"
          class="text-xs font-mono px-3 py-1.5 rounded transition-colors bg-panel-900 text-white font-medium focus:outline-none focus:ring-1 focus:ring-accent-500"
        >
          {t('idp.nav.catalog')}
        </a>
        <a
          href={translatePath('/lab/idp/architecture')}
          class="text-xs font-mono px-3 py-1.5 rounded transition-colors text-ink-600 hover:text-ink-900 hover:bg-panel-100 border border-panel-200 focus:outline-none focus:ring-1 focus:ring-accent-500"
        >
          {t('idp.nav.architecture')}
        </a>
      </nav>
    </header>

    <!-- Categories Grid -->
    <div class="space-y-16">
      {idpCatalog.categories.map((category, index) => {
        const catNumber = String(index + 1).padStart(2, '0');
        const catTitle = isEs ? category.nameEs : category.name;
        const catDesc = isEs ? category.descriptionEs : category.description;

        return (
          <section id={category.id} class="scroll-mt-24">
            <SectionHeading number={catNumber} label={catTitle} margin="mb-2" />
            <p class="text-xs sm:text-sm text-ink-600 max-w-2xl mb-6">
              {catDesc}
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {category.items.map((item) => {
                const itemDesc = isEs ? item.descriptionEs : item.description;
                const spend = item.spendBadge ? (isEs ? item.spendBadge.es : item.spendBadge.en) : null;
                const isPublic = item.access === 'public' && Boolean(item.url);

                return (
                  <article class="flex flex-col justify-between p-4 rounded-lg bg-panel-50 border border-panel-200 hover:border-panel-300 transition-colors">
                    <div>
                      <div class="flex items-start justify-between gap-3 mb-2.5">
                        <div class="flex items-center gap-2.5 min-w-0">
                          <div class="text-ink-700 shrink-0">
                            <IdpIcon name={item.icon} class="w-5 h-5" />
                          </div>
                          <h3 class="text-sm font-semibold text-ink-900 truncate">
                            {item.name}
                          </h3>
                        </div>
                        {spend && (
                          <span class="shrink-0 text-xs font-mono font-medium px-2 py-0.5 rounded bg-panel-200 text-panel-800 border border-panel-300">
                            {spend}
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-ink-600 leading-relaxed mb-4">
                        {itemDesc}
                      </p>
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-panel-200/60 mt-auto">
                      <span class:list={[
                        'text-xs font-mono px-2 py-0.5 rounded border uppercase tracking-wider',
                        ACCESS_BADGE[item.access]
                      ]}>
                        {ACCESS_LABEL[item.access]}
                      </span>

                      {isPublic ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 text-xs font-medium text-accent-700 hover:text-accent-900 transition-colors focus:outline-none focus:underline"
                        >
                          <span>{t('idp.action.open')}</span>
                          <span class="sr-only"> ({item.name})</span>
                          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                          </svg>
                        </a>
                      ) : (
                        <span class="text-xs font-mono text-panel-700">
                          {t('idp.action.internal')}
                        </span>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>

    <!-- Provenance notice -->
    <footer class="mt-20 pt-8 border-t border-panel-200 text-xs font-mono text-ink-500 text-center">
      <p>
        {t('idp.catalog.source')
          .replace('{repo}', idpCatalog.source.repo)
          .replace('{commit}', idpCatalog.source.commit.slice(0, 7))}
      </p>
    </footer>
  </main>

  <Footer />
</BaseLayout>
