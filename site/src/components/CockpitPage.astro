              <span class="font-bold text-gray-900 text-sm font-mono">{t('cockpit.d.90DayPlatformAvailability')}</span>
            </div>
            <span class="font-mono font-bold text-emerald-700 text-sm">{cockpit.cluster.uptime}</span>
          </div>
          <p class="text-[11px] font-mono text-gray-500">{t('cockpit.snapshot')}</p>
        </div>

        <!-- Grid of SLI vs SLO Targets -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 font-mono text-xs mt-4">
          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] text-gray-500 uppercase tracking-wider block mb-1">{t('cockpit.d.availabilitySlo')}</span>
            <div class="flex items-baseline justify-between">
              <span class="text-xl font-bold text-gray-900">{cockpit.cluster.uptime}</span>
              <span class="text-[10px] text-gray-500">{t('cockpit.d.target995')}</span>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block mt-1">● NOMINAL (Uptime Kuma)</span>
          </div>

          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] text-gray-500 uppercase tracking-wider block mb-1">{t('cockpit.d.edgeIngressP95')}</span>
            <div class="flex items-baseline justify-between">
              <span class="text-xl font-bold text-gray-900">~42ms</span>
              <span class="text-[10px] text-gray-500">{t('cockpit.d.targetLt100ms')}</span>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block mt-1">● TRAEFIK + CLOUDFLARE</span>
          </div>

          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] text-gray-500 uppercase tracking-wider block mb-1">{t('cockpit.d.gitopsDriftLoop')}</span>
            <div class="flex items-baseline justify-between">
              <span class="text-xl font-bold text-gray-900">{cockpit.metrics.gitopsSyncLoop}</span>
              <span class="text-[10px] text-gray-500">{t('cockpit.d.targetLt60s')}</span>
            </div>
            <span class="text-[10px] text-emerald-700 font-semibold block mt-1">● ARGO CD RECONCILER</span>
          </div>

          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] text-gray-500 uppercase tracking-wider block mb-1">{t('cockpit.d.cudaEdgeTtft')}</span>
            <div class="flex items-baseline justify-between">
              <span class="text-xl font-bold text-gray-900">{cockpit.metrics.inferenceLatency}</span>
              <span class="text-[10px] text-gray-500">{t('cockpit.d.targetLt50s')}</span>
            </div>
            <span class="text-[10px] text-purple-700 font-semibold block mt-1">● JETSON NANO (QWEN 1.5B)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6: Client-Side Health Verification -->
    <section
      class="py-10 border-t border-gray-100"
      data-cockpit-console
      data-probe-i18n={JSON.stringify({
        running: t('cockpit.probe.running'),
        checking: t('cockpit.probe.checking'),
        probing: t('cockpit.probe.probing'),
        reachable: t('cockpit.probe.reachable'),
        unreachable: t('cockpit.probe.unreachable'),
        result: t('cockpit.probe.result'),
        summary: t('cockpit.probe.summary'),
        lastRun: t('cockpit.probe.lastRun'),
      })}
    >
      <div class="max-w-4xl mx-auto px-4">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 mb-4">
          <div>
            <h2 class="text-sm font-medium text-gray-500 tracking-widest uppercase">
              <span class="text-cyan-700">[ 06 /</span> {t('cockpit.probe.heading')} <span class="text-cyan-700">]</span>
            </h2>
            <p class="text-xs text-gray-500 mt-1">{t('cockpit.probe.sub')}</p>
          </div>
          <button
            type="button"
            data-action="run-probe"
            class="inline-flex items-center gap-1.5 bg-gray-900 hover:bg-gray-800 text-white text-xs font-mono font-medium px-3.5 py-2 rounded-lg transition-all shadow-sm active:scale-95 cursor-pointer self-start sm:self-auto"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>{t('cockpit.probe.btn')}</span>
          </button>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 font-mono text-xs text-slate-300 shadow-md">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 text-slate-400 text-[11px]">
            <span>{t('cockpit.d.cockpitProbeRunnerBrowser')}</span>
            <span data-probe-status>{t('cockpit.d.ready')}</span>
          </div>

          <div
            data-probe-log
            class="py-3 space-y-1.5 min-h-[120px] max-h-[220px] overflow-y-auto font-mono text-[12px] select-text"
          >
            <p class="text-slate-500">{t('cockpit.d.readyToVerifyLive')}</p>
          </div>

          <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-500">
            <span data-probe-timestamp>{t('cockpit.probe.timestamp')}: --</span>
            <span class="text-emerald-400 font-medium">{t('cockpit.d.nonBlockingCorsCheck')}</span>
          </div>
        </div>
      </div>
