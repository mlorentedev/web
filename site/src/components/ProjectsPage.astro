---
// Renders the projects page for one locale, the way ContactPage renders the
// contact ones: the intro comes from that locale's markdown and the cards from
// portfolio.ts, localized.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { projects, localize } from '../data/portfolio';
import { ghchartSrc } from '../data/site';
import { softwareSourceCode } from '../data/structured-data';
import ProjectCard from './ProjectCard.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const featured = projects.filter((p) => p.featured);
const other = projects.filter((p) => !p.featured);
const schema = [...featured, ...other].map((p) => softwareSourceCode(localize(p, lang), lang));

const [page] = await getCollection('pages', ({ data }: CollectionEntry<'pages'>) => data.page === 'projects' && data.lang === lang);
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description} schema={schema}>
  <Header />
  <main id="main-content" class="grow">
    <section class="pt-8 pb-12 md:pt-10 md:pb-14">
      <div class="max-w-3xl mx-auto px-4">
        <h1 class="sr-only">{page.data.title}</h1>
        <div class="prose prose-base max-w-none prose-p:text-base/6 prose-p:text-gray-700 mb-10">
          <Content />
        </div>
        <a href="https://github.com/mlorentedev" class="block">
          <img
            src={ghchartSrc}
            alt={t('meta.ghchart.alt')}
            width="663"
            height="104"
            class="w-full mb-10 hover:opacity-80 transition-opacity"
            loading="lazy"
          />
        </a>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[...featured, ...other].map((project) => (
            <ProjectCard project={localize(project, lang)} lang={lang} level={2} />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
