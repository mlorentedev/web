{
  "name": "mlorente.dev",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "diagrams": "node scripts/diagrams.mjs generate",
    "prebuild": "node scripts/diagrams.mjs verify",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:audit": "node --test tests/lab-audit.test.mjs",
    "test:browser": "node tests/lab-containment.mjs && node tests/home-first-screen.mjs",
    "test:a11y": "node tests/lab-axe.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@beoe/rehype-code-hook-img": "^0.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "^1.63.0",
    "semver": "^7.8.5",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
