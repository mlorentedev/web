{
  "name": "mlorente.dev",
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "diagrams": "node scripts/diagrams.mjs generate",
    "fonts": "node scripts/subset-fonts.mjs",
    "prebuild": "node scripts/diagrams.mjs verify",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "pretest": "node scripts/check-node.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:audit": "node --test tests/lab-audit.test.mjs",
    "test:browser": "node tests/lab-containment.mjs && node tests/home-first-screen.mjs && node tests/header-layout.mjs && node tests/visual-diff-motion.mjs && node tests/target-size.mjs && node tests/print-styles.mjs && node tests/font-preloads.mjs",
    "test:a11y": "node tests/lab-axe.mjs && node tests/focus-ring.mjs && node tests/svg-text-contrast.mjs",
    "test:all": "npm test && npm run test:browser && npm run test:a11y",
    "test:access": "node --test tests/access.live.mjs",
    "test:links": "node --test tests/catalog.live.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@beoe/rehype-code-hook-img": "^0.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "mermaid-isomorphic": "^3.1.0",
    "parse5": "^7.3.0",
    "playwright": "^1.64.1",
    "semver": "^7.8.5",
    "subset-font": "2.9.0",
    "typescript": "^5.8.2"
  }
}
